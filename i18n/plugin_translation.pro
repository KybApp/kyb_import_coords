# i18n/plugin_translation.pro

# Файлы с QCoreApplication.translate(...)
SOURCES = ../dialog.py \
          ../plugin.py

# Языки: суффикс = ISO 639-1 (совпадает с locale/userLocale[:2])
TRANSLATIONS = plugin_ru.ts \
               plugin_en.ts \
               plugin_de.ts \
               plugin_fr.ts \
               plugin_es.ts \
               plugin_it.ts \
               plugin_zh.ts \
               plugin_kk.ts